; Standalone Godot 4.5.2 preview project for Bomb Cart (炸彈推車).
; Excluded from the release ZIP by scripts/pack-mod.mjs (project.godot).
; Local preview:
;   Godot --headless --path mods/bomb-cart -- --self-test
;   Godot --path mods/bomb-cart --windowed --resolution 1280x720

config_version=5

[application]

config/name="Bomb Cart"
run/main_scene="res://bomb_cart_scene.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
